{
 "cleanUrls": false,
 "trailingSlash": true,
 "rewrites": [
  {
   "source": "/daily.xml",
   "destination": "/api/feed"
  }
 ],
 "crons": [
  {
   "path": "/api/telegram?daily=1",
   "schedule": "30 7 * * *"
  }
 ],
 "headers": [
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  }
 ]
}